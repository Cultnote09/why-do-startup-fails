	partition Failures = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/Failures.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Write-up", type text}, {"Startup", type text}, {"Slug", type text}, {"Country", type text}, {"Country (top 12)", type text}, {"Industry", type text}, {"Industry Group", type text}, {"Prominence", type text}, {"Category", type text}, {"Founded Year", Int64.Type}, {"Failed Year", Int64.Type}, {"Lifespan Years", Int64.Type}, {"Failure Theme", type text}, {"Theme Sort", Int64.Type}, {"Failure Reason", type text}, {"Lesson", type text}, {"Funding Label", type text}, {"Funding USD", type number}, {"Peak Valuation USD", type number}, {"Employees At Peak", Int64.Type}, {"Investors", type text}, {"Url", type text}}, "en-US"),
				    Selected = Table.SelectColumns(Typed, {"Write-up", "Startup", "Slug", "Country", "Country (top 12)", "Industry", "Industry Group", "Prominence", "Category", "Founded Year", "Failed Year", "Lifespan Years", "Failure Theme", "Theme Sort", "Failure Reason", "Lesson", "Funding Label", "Funding USD", "Peak Valuation USD", "Employees At Peak", "Investors", "Url"})
				in
				    Selected

	annotation PBI_ResultType = Table

