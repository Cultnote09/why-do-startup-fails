table Failures
	lineageTag: b816d380-0e55-4793-9722-68770892486a

	measure 'Failed startups' = COUNTROWS ( Failures )
		formatString: #,0
		displayFolder: Metrics
		lineageTag: 81234088-682d-4bd7-addb-28983a16f763

	measure 'Funding raised ($M)' = DIVIDE ( SUM ( Failures[Funding USD] ), 1000000 )
		formatString: #,0.0
		displayFolder: Metrics
		lineageTag: 72796275-fd07-456f-a428-13dc1d8b69a4

	measure 'Funding raised ($B)' = DIVIDE ( SUM ( Failures[Funding USD] ), 1000000000 )
		formatString: #,0.0
		displayFolder: Metrics
		lineageTag: 4a91c0e2-7b56-4d18-9f33-6e2c8a1b0d47

	measure 'Median funding ($M)' = DIVIDE ( MEDIAN ( Failures[Funding USD] ), 1000000 )
		formatString: #,0.0
		displayFolder: Metrics
		lineageTag: 7d6a3e6a-505c-4ed9-bcf6-a7e714faf6d2

	measure 'Median lifespan (years)' = MEDIAN ( Failures[Lifespan Years] )
		formatString: 0.0
		displayFolder: Metrics
		lineageTag: b8bb6f29-c21d-4632-87d6-c8465a67db7c

	measure Countries = CALCULATE ( DISTINCTCOUNT ( Failures[Country] ), Failures[Country] <> "Unknown" )
		formatString: #,0
		displayFolder: Metrics
		lineageTag: e6bf5ea4-96f8-4aa6-ad5a-55abfcfbc9d2

