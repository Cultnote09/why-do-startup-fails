	partition SectorCases = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "/SectorCases.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Startup", type text}, {"Sector", type text}, {"What They Did", type text}, {"Why They Failed", type text}, {"Takeaway", type text}, {"Raised Label", type text}, {"Raised USD", type number}, {"Start Year", Int64.Type}, {"End Year", Int64.Type}, {"Lifespan Years", Int64.Type}, {"Driver Count", Int64.Type}}, "en-US"),
				    Selected = Table.SelectColumns(Typed, {"Startup", "Sector", "What They Did", "Why They Failed", "Takeaway", "Raised Label", "Raised USD", "Start Year", "End Year", "Lifespan Years", "Driver Count"})
				in
				    Selected

	annotation PBI_ResultType = Table

