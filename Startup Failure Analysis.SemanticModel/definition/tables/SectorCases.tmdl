table SectorCases
	lineageTag: 5b6df015-2e27-4f4c-9792-ddbf8445510e

	measure 'Sector cases' = COUNTROWS ( SectorCases )
		formatString: #,0
		displayFolder: Metrics
		lineageTag: b7306187-9b74-4247-86ba-758703f4b5e7

	measure 'Sector funding ($B)' = DIVIDE ( SUM ( SectorCases[Raised USD] ), 1000000000 )
		formatString: #,0.0
		displayFolder: Metrics
		lineageTag: aad1bf9e-b60c-4079-a733-ea30d6ffbbca

